#include <iostream>
using namespace std;

int main() {
    int num1, num2, num3;
    int mayor;

    cout << "Ingresa el primer numero: ";
    cin >> num1;

    cout << "Ingresa el segundo numero: ";
    cin >> num2;

    cout << "Ingresa el tercer numero: ";
    cin >> num3;

    // Comparacion de numeros
    if (num1 >= num2 && num1 >= num3) {
        mayor = num1;
    } 
    else if (num2 >= num1 && num2 >= num3) {
        mayor = num2;
    } 
    else {
        mayor = num3;
    }

    // RESULTADO
    cout << "El numero mayor es: " << mayor << endl;

    return 0;
}
